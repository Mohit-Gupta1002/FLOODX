# FLOODX Environment Variables
# Note: FLOODX works completely out of the box with open data (Open-Meteo) and fallback simulated telemetry.
# The following keys are optional for enhanced production feeds.

NEXT_PUBLIC_APP_NAME="FLOODX"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_DEFAULT_CITY="Bengaluru"

# Open-Meteo Weather API (Free, no key required)
NEXT_PUBLIC_OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# India Meteorological Department (IMD) Open Data Adapter (Optional mock/live proxy)
IMD_API_KEY=""
IMD_API_ENDPOINT="https://mausam.imd.gov.in/api"

# ISRO / NRSC Bhuvan Flood Inundation WMS/WFS (Optional)
NRSC_BHUVAN_WMS_URL="https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms"

# Central Water Commission (CWC) River Stage Telemetry (Optional)
CWC_TELEMETRY_ENDPOINT="https://ffs.india-water.gov.in/api"

# Emergency SMS Gateway (Mock mode active by default)
ALERT_SMS_API_KEY=""
ALERT_SMS_SENDER_ID="FLOODX"
